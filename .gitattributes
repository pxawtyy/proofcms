# Auto-detect text files and normalize line endings to LF on commit.
# This keeps Windows (CRLF) and Linux/macOS (LF) checkouts consistent and
# silences bogus "LF will be replaced by CRLF" churn in diffs.
* text=auto eol=lf

# Explicit binary guards so Git never tries to normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.whl binary
*.exe binary
*.dll binary
*.so binary
*.bin binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
